# ---- Required -------------------------------------------------------------
# Groq: chat completions (gpt-oss-120b), emotion analysis (gpt-oss-20b) and
# speech-to-text (Whisper large-v3-turbo). One key covers all three.
GROQ_API_KEY=

# ---- Optional: LLM provider override ----------------------------------------
# Set to use OpenRouter instead of Groq for chat/analysis (OpenAI-compatible).
# OPENROUTER_API_KEY=
# LLM_CHAT_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b

# ---- Optional: text-to-speech ------------------------------------------------
# Without this the browser's built-in SpeechSynthesis is used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ---- Optional but needed for proactive check-ins in production ----------------
# Upstash Redis (Vercel Marketplace -> Upstash, or upstash.com). Without it the
# app keeps state in memory per serverless instance, which vanishes between
# invocations, so the cron sweep will never find anyone to check in on.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protects /api/checkin/sweep. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Signs the login cookie. Any long random string.
SESSION_SECRET=

# ---- Optional: hardening ------------------------------------------------------
# Encrypts every stored user record (AES-256-GCM). `openssl rand -hex 32`
DATA_ENCRYPTION_KEY=

# Web Push for check-ins while the tab is closed. `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Model used for the safety second opinion (defaults to the fast model).
# LLM_SAFETY_MODEL=

# Gates /api/admin/* (full analytics per user + JSONL training export). Unset = disabled.
ADMIN_SECRET=

# ---- Accounts + durable storage: Supabase (free tier) --------------------------
# Project → Settings → API. The two NEXT_PUBLIC_ values are safe in the browser;
# the service role key is server-only and must never be exposed.
# Run supabase/schema.sql once in the SQL editor. Auth → Providers → Email:
# "Confirm email" can stay on (we handle the confirmation step) or off for simplicity.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
